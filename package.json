{
  "name": "to-do-list",
  "description": "A web-based to-do list app, created as a part of my journey with The Odin Project.",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve --config webpack.dev.js",
    "start:open-browser": "npm start -- --open",
    "build": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "commit:all": "git add . && git commit",
    "push": "git push origin main",
    "commit:all:push": "npm run commit:all && npm run push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alikamel-dev/to-do-list.git"
  },
  "keywords": [
    "ali-kamel",
    "alikamel-dev",
    "to-do-list",
    "todo-list",
    "the-odin-project",
    "top",
    "the-odin-project-to-do-list",
    "the-odin-project-todo-list",
    "top-to-do-list",
    "top-todo-list",
    "html-css-js",
    "html-css-javascript",
    "html",
    "css",
    "js",
    "javascript",
    "webpack",
    "webpack-project",
    "webpack-html-css-js",
    "webpack-html-css-javascript"
  ],
  "author": "alikamel-dev <ali.kamel.ali.2004@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alikamel-dev/to-do-list/issues"
  },
  "homepage": "https://github.com/alikamel-dev/to-do-list#readme",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "date-fns": "^4.1.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-font-preload-plugin": "^1.3.0",
    "webpack-merge": "^6.0.1"
  }
}
